# RPC Polygon Amoy — Alchemy (recommandé) ou endpoint public
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Clé privée du wallet relayer (le compte déployeur enregistré comme acteur)
PRIVATE_KEY=your_private_key_here

# Adresse du contrat ChainCacao déployé (dans blockchain/deployment.json)
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Port du serveur (optionnel, défaut : 3001)
PORT=3001
